# Copie este arquivo para .env e preencha os valores. Nunca commite o .env
# real — ele já está no .gitignore.

TELEGRAM_TOKEN=
AWS_REGION=us-east-1
SQS_URL="http://localhost:4566/000000000000/tel-bot-queue"

# Opcional: endpoint do SQS. Vazio = usa a AWS real (produção, via IAM
# Role). Setado = sobrescreve para desenvolvimento local (ex.: LocalStack).
SQS_ENDPOINT="http://localhost:4566"

# Opcional (P3.3): fila usada pelo consumer Java para publicar status de
# entrega da Twilio de volta ao bot.
STATUS_QUEUE_URL=

# Opcional: número padrão de WhatsApp (DDD+número, sem o +55) usado quando
# o chat não configurou um destino via /destino. Se vazio, todo chat
# precisa rodar /destino antes de enviar mensagens.
SEU_NUMERO=

# Opcional (S3/P3.1): lista de chat_id do Telegram autorizados a usar o
# bot, separados por vírgula. Vazio = qualquer usuário pode usar.
ALLOWED_CHAT_IDS=

# Opcional (P3.2): caminho do arquivo de persistência do mapeamento
# chat -> destino de WhatsApp. Padrão: destinations.json
DESTINATIONS_FILE=destinations.json
