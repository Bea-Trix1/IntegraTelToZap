# Copie para .env na raiz do projeto e preencha os valores reais antes de
# rodar `docker compose up`. Nunca commite o .env real.

# Bot Telegram (Tel-To-Zap-Go) — token gerado via @BotFather
TELEGRAM_TOKEN=

# Twilio (consumer-to-zap)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Token de acesso (S1) exigido nos endpoints internos do consumer
# (ex.: /actuator/prometheus). Gere algo aleatório, ex.: openssl rand -hex 32
APP_ACCESS_TOKEN=

# Opcional (S3/P3.1): chat_id do Telegram autorizados a usar o bot,
# separados por vírgula. Vazio = qualquer usuário pode usar.
ALLOWED_CHAT_IDS=

# Opcional: número padrão de WhatsApp (DDD+número, sem o +55) usado quando
# o chat não configurou destino via /destino.
SEU_NUMERO=
